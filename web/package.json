{
  "name": "@pifpaf/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pif Paf のUI（React + Vite）。ゲームルールは持たず、@pifpaf/engine を呼び出すだけ。",
  "scripts": {
    "dev": "vite",
    "dev:lan": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@pifpaf/engine": "*",
    "@pifpaf/protocol": "0.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
